# iLog Agent configuration (/etc/ilog/config.toml)
#
# Log sources live in a separate file (/etc/ilog/sources.yaml, see
# config.example.yaml). Any key can be overridden by env with prefix ILOG:
# ILOG_AGENT_TOKEN -> agent.token, ILOG_AGENT_SERVER -> agent.server.

[agent]
# Backend TCP ingest, host:port (default port 8081).
server = "ilog.example.com:8081"

# Agent token from the dashboard (Services -> Tokens).
token = "agt_<agent_id>_<secret>"
