# Database (TimescaleDB) Configuration
POSTGRES_DB=ilog
POSTGRES_USER=ilog
POSTGRES_PASSWORD= # openssl rand -base64 32
TIMESCALEDB_TELEMETRY=off
DATABASE_URL=postgresql://ilog:POSTGRES_PASSWORD@timescaledb:5432/ilog

# Backend Configuration
RUST_LOG=info
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Required, min 32 chars. The backend refuses to start without it: a built-in
# default would let anyone who has read the source forge session tokens.
JWT_SECRET= # openssl rand -base64 32
# Required, min 32 chars. Wraps agent key secrets at rest. Must stay stable
# across restarts and deploys -- change it and every existing agent token
# becomes undecryptable and has to be reissued. Back it up with your other
# secrets.
TOKEN_ENCRYPTION_KEY= # openssl rand -base64 48
FRONTEND_URL=http://localhost:3000
ALLOW_PUBLIC_SIGNUP=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
